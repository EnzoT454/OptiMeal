{
  "$defs": {
    "InputFingerprint": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "InputFingerprint",
      "type": "object"
    },
    "NormalizedSale": {
      "additionalProperties": false,
      "description": "Instantané autonome ; un format lisible ne garantit ni tarif ni équivalence.",
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "ingredient_id": {
          "pattern": "^ing_[a-z0-9_]+$",
          "title": "Ingredient Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "raw_source": {
          "$ref": "#/$defs/SourceProduct"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "enum": [
            "missing",
            "matched",
            "stale",
            "identity_mismatch"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ProductFormat"
        },
        "format_status": {
          "enum": [
            "candidate",
            "verified",
            "unknown"
          ],
          "title": "Format Status",
          "type": "string"
        },
        "content_per_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "mass",
                "volume",
                "count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dimension"
        },
        "price_basis": {
          "enum": [
            "package",
            "weight",
            "count",
            "unknown"
          ],
          "title": "Price Basis",
          "type": "string"
        },
        "price_per_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "sale_increment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_sale": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicable_price": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicable Price"
        },
        "applicable_price_kind": {
          "enum": [
            "regular",
            "promotion",
            "unknown"
          ],
          "title": "Applicable Price Kind",
          "type": "string"
        },
        "quantity_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity Limit"
        },
        "price_after_limit": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price After Limit"
        },
        "evaluated_on": {
          "format": "date",
          "title": "Evaluated On",
          "type": "string"
        },
        "match_status": {
          "enum": [
            "verified",
            "proposed",
            "rejected"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "scope": {
          "enum": [
            "store",
            "retailer",
            "unknown"
          ],
          "title": "Scope",
          "type": "string"
        },
        "conditions": {
          "enum": [
            "unconditional",
            "member",
            "coupon",
            "multi_buy",
            "unknown"
          ],
          "title": "Conditions",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "eligible_for_calculation": {
          "title": "Eligible For Calculation",
          "type": "boolean"
        }
      },
      "required": [
        "product_id",
        "ingredient_id",
        "source_fingerprint",
        "raw_source",
        "review",
        "review_status",
        "format",
        "format_status",
        "content_per_package",
        "dimension",
        "price_basis",
        "price_per_quantity",
        "sale_increment",
        "minimum_sale",
        "applicable_price",
        "applicable_price_kind",
        "quantity_limit",
        "price_after_limit",
        "evaluated_on",
        "match_status",
        "scope",
        "conditions",
        "issues",
        "eligible_for_calculation"
      ],
      "title": "NormalizedSale",
      "type": "object"
    },
    "ProductFormat": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "kind": {
          "enum": [
            "fixed",
            "variable_weight",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "g",
                "ml",
                "unit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "package_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Count"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "raw",
        "kind"
      ],
      "title": "ProductFormat",
      "type": "object"
    },
    "SaleBaseQuantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "unit"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "SaleBaseQuantity",
      "type": "object"
    },
    "SaleQuantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "SaleQuantity",
      "type": "object"
    },
    "SaleReview": {
      "additionalProperties": false,
      "description": "Attestation explicite ; ne constitue jamais une vérification automatique.",
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "ingredient_id": {
          "pattern": "^ing_[a-z0-9_]+$",
          "title": "Ingredient Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "method": {
          "enum": [
            "source_document",
            "manual_review"
          ],
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "format_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Raw"
        },
        "price_basis_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Basis Raw"
        },
        "price_basis": {
          "default": "unknown",
          "enum": [
            "package",
            "weight",
            "count",
            "unknown"
          ],
          "title": "Price Basis",
          "type": "string"
        },
        "price_per_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sale_increment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum_sale": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "match_status": {
          "default": "proposed",
          "enum": [
            "verified",
            "proposed",
            "rejected"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "scope": {
          "default": "unknown",
          "enum": [
            "store",
            "retailer",
            "unknown"
          ],
          "title": "Scope",
          "type": "string"
        },
        "conditions": {
          "default": "unknown",
          "enum": [
            "unconditional",
            "member",
            "coupon",
            "multi_buy",
            "unknown"
          ],
          "title": "Conditions",
          "type": "string"
        },
        "zero_price_verified": {
          "default": false,
          "title": "Zero Price Verified",
          "type": "boolean"
        }
      },
      "required": [
        "product_id",
        "ingredient_id",
        "source_fingerprint",
        "checked_at",
        "method",
        "reference"
      ],
      "title": "SaleReview",
      "type": "object"
    },
    "SourceProduct": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "retailer": {
          "enum": [
            "maxi",
            "metro",
            "superc"
          ],
          "title": "Retailer",
          "type": "string"
        },
        "store_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Id"
        },
        "external_product_id": {
          "minLength": 1,
          "title": "External Product Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "promo_price": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promo Price"
        },
        "quantity_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Limit"
        },
        "price_after_limit": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price After Limit"
        },
        "currency": {
          "const": "CAD",
          "title": "Currency",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid To"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "is_promotion": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Is Promotion"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "image_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Source"
        }
      },
      "required": [
        "id",
        "retailer",
        "store_id",
        "external_product_id",
        "name",
        "price",
        "currency",
        "unit",
        "quantity",
        "valid_from",
        "valid_to",
        "is_promotion",
        "source",
        "url"
      ],
      "title": "SourceProduct",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "sale-normalization-1.0",
      "default": "sale-normalization-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "common_catalog",
        "postgresql"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/InputFingerprint"
      },
      "title": "Source Inputs",
      "type": "array"
    },
    "evaluated_on": {
      "format": "date",
      "title": "Evaluated On",
      "type": "string"
    },
    "product_count": {
      "minimum": 0,
      "title": "Product Count",
      "type": "integer"
    },
    "eligible_count": {
      "minimum": 0,
      "title": "Eligible Count",
      "type": "integer"
    },
    "issue_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Issue Counts",
      "type": "object"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/NormalizedSale"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "source_kind",
    "source_inputs",
    "evaluated_on",
    "product_count",
    "eligible_count",
    "issue_counts",
    "items"
  ],
  "title": "SaleNormalizationReport",
  "type": "object"
}
