{
  "$defs": {
    "NormalizedSale": {
      "additionalProperties": false,
      "description": "Instantané autonome ; un format lisible ne garantit ni tarif ni équivalence.",
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "ingredient_id": {
          "pattern": "^ing_[a-z0-9_]+$",
          "title": "Ingredient Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "raw_source": {
          "$ref": "#/$defs/SourceProduct"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "enum": [
            "missing",
            "matched",
            "stale",
            "identity_mismatch"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ProductFormat"
        },
        "format_status": {
          "enum": [
            "candidate",
            "verified",
            "unknown"
          ],
          "title": "Format Status",
          "type": "string"
        },
        "content_per_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "mass",
                "volume",
                "count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dimension"
        },
        "price_basis": {
          "enum": [
            "package",
            "weight",
            "count",
            "unknown"
          ],
          "title": "Price Basis",
          "type": "string"
        },
        "price_per_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "sale_increment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_sale": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaleBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicable_price": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicable Price"
        },
        "applicable_price_kind": {
          "enum": [
            "regular",
            "promotion",
            "unknown"
          ],
          "title": "Applicable Price Kind",
          "type": "string"
        },
        "quantity_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity Limit"
        },
        "price_after_limit": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price After Limit"
        },
        "evaluated_on": {
          "format": "date",
          "title": "Evaluated On",
          "type": "string"
        },
        "match_status": {
          "enum": [
            "verified",
            "proposed",
            "rejected"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "scope": {
          "enum": [
            "store",
            "retailer",
            "unknown"
          ],
          "title": "Scope",
          "type": "string"
        },
        "conditions": {
          "enum": [
            "unconditional",
            "member",
            "coupon",
            "multi_buy",
            "unknown"
          ],
          "title": "Conditions",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "eligible_for_calculation": {
          "title": "Eligible For Calculation",
          "type": "boolean"
        }
      },
      "required": [
        "product_id",
        "ingredient_id",
        "source_fingerprint",
        "raw_source",
        "review",
        "review_status",
        "format",
        "format_status",
        "content_per_package",
        "dimension",
        "price_basis",
        "price_per_quantity",
        "sale_increment",
        "minimum_sale",
        "applicable_price",
        "applicable_price_kind",
        "quantity_limit",
        "price_after_limit",
        "evaluated_on",
        "match_status",
        "scope",
        "conditions",
        "issues",
        "eligible_for_calculation"
      ],
      "title": "NormalizedSale",
      "type": "object"
    },
    "ProductFormat": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "kind": {
          "enum": [
            "fixed",
            "variable_weight",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "g",
                "ml",
                "unit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "package_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Count"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "raw",
        "kind"
      ],
      "title": "ProductFormat",
      "type": "object"
    },
    "ResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_source": {
          "default": "local_json",
          "enum": [
            "local_json",
            "postgresql"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "source_snapshot",
            "demo",
            "user_content",
            "mixed"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "dataset_kind"
      ],
      "title": "ResponseMeta",
      "type": "object"
    },
