{
  "$defs": {
    "ResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_source": {
          "default": "local_json",
          "enum": [
            "local_json",
            "postgresql"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "source_snapshot",
            "demo",
            "user_content",
            "mixed"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "dataset_kind"
      ],
      "title": "ResponseMeta",
      "type": "object"
    },
    "ShoppingBaseQuantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "unit"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "ShoppingBaseQuantity",
      "type": "object"
    },
    "ShoppingCalendarPreviewRead": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "$ref": "#/$defs/ShoppingPeriod"
        },
        "purchase_date": {
          "format": "date",
          "title": "Purchase Date",
          "type": "string"
        },
        "preview_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preview Fingerprint",
          "type": "string"
        },
        "included_meal_count": {
          "minimum": 0,
          "title": "Included Meal Count",
          "type": "integer"
        },
        "skipped_note_count": {
          "minimum": 0,
          "title": "Skipped Note Count",
          "type": "integer"
        },
        "skipped_leftover_count": {
          "minimum": 0,
          "title": "Skipped Leftover Count",
          "type": "integer"
        },
        "excluded_meals": {
          "items": {
            "$ref": "#/$defs/ShoppingExcludedMeal"
          },
          "title": "Excluded Meals",
          "type": "array"
        },
        "excluded_ingredient_ids": {
          "items": {
            "pattern": "^ing_[a-z0-9_]+$",
            "type": "string"
          },
          "title": "Excluded Ingredient Ids",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ShoppingItemRead"
          },
          "title": "Items",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ShoppingWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "period",
        "purchase_date",
        "preview_fingerprint",
        "included_meal_count",
        "skipped_note_count",
        "skipped_leftover_count",
        "excluded_meals",
        "excluded_ingredient_ids",
        "items"
      ],
      "title": "ShoppingCalendarPreviewRead",
      "type": "object"
    },
    "ShoppingContributionRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "manual",
            "calendar"
          ],
          "title": "Source",
          "type": "string"
        },
        "original_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShoppingQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShoppingBaseQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "meal_entry_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meal Entry Id"
        },
        "recipe_id": {
          "anyOf": [
            {
              "pattern": "^recipe_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Id"
        },
        "recipe_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Name"
        },
        "recipe_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Version"
        },
        "recipe_servings": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Servings"
        },
        "meal_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meal Date"
        },
        "servings": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Servings"
        }
      },
      "required": [
        "id",
        "source",
        "original_quantity",
        "normalized_quantity"
      ],
      "title": "ShoppingContributionRead",
      "type": "object"
    },
    "ShoppingExcludedMeal": {
      "additionalProperties": false,
      "properties": {
        "meal_entry_id": {
          "format": "uuid",
          "title": "Meal Entry Id",
          "type": "string"
        },
        "reason": {
          "const": "recipe_unavailable",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "meal_entry_id",
        "reason"
      ],
      "title": "ShoppingExcludedMeal",
      "type": "object"
    },
    "ShoppingItemRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "ingredient_id": {
          "anyOf": [
            {
              "pattern": "^ing_[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ingredient Id"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "need_revision": {
          "minimum": 1,
          "title": "Need Revision",
          "type": "integer"
        },
        "required": {
          "items": {
            "$ref": "#/$defs/ShoppingBaseQuantity"
          },
          "maxItems": 3,
          "title": "Required",
          "type": "array"
        },
        "owned": {
          "items": {
            "$ref": "#/$defs/ShoppingBaseQuantity"
          },
          "maxItems": 3,
          "title": "Owned",
          "type": "array"
        },
        "owned_unquantified_need_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owned Unquantified Need Revision"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/ShoppingContributionRead"
          },
          "title": "Contributions",
          "type": "array"
        },
        "removed": {
          "default": false,
          "title": "Removed",
          "type": "boolean"
        },
        "coverage_status": {
          "enum": [
            "remaining",
            "partial",
            "purchased",
            "owned"
          ],
          "title": "Coverage Status",
          "type": "string"
        },
        "pricing_status": {
          "enum": [
            "unpriced",
            "known",
            "needs_review"
          ],
          "title": "Pricing Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ingredient_id",
        "name",
        "category",
        "need_revision",
        "required",
        "contributions",
        "coverage_status",
        "pricing_status"
      ],
      "title": "ShoppingItemRead",
      "type": "object"
    },
    "ShoppingPeriod": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "ShoppingPeriod",
      "type": "object"
    },
    "ShoppingQuantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "kg",
            "ml",
            "L",
            "unit",
            "cup",
            "tbsp",
            "tsp"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "ShoppingQuantity",
      "type": "object"
    },
    "ShoppingWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ShoppingWarning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "item": {
      "$ref": "#/$defs/ShoppingCalendarPreviewRead"
    },
    "meta": {
      "$ref": "#/$defs/ResponseMeta"
    }
  },
  "required": [
    "item",
    "meta"
  ],
  "title": "Detail[ShoppingCalendarPreviewRead]",
  "type": "object"
}
