{
  "$defs": {
    "RecipeIngredient": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "pattern": "^ing_[a-z0-9_]+$",
          "title": "Ingredient Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "unit"
          ],
          "title": "Unit",
          "type": "string"
        },
        "preparation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preparation"
        }
      },
      "required": [
        "ingredient_id",
        "quantity",
        "unit",
        "preparation"
      ],
      "title": "RecipeIngredient",
      "type": "object"
    },
    "RecipeRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "servings": {
          "exclusiveMinimum": 0,
          "title": "Servings",
          "type": "integer"
        },
        "total_time_minutes": {
          "minimum": 0,
          "title": "Total Time Minutes",
          "type": "integer"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Url"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "is_owned": {
          "default": false,
          "title": "Is Owned",
          "type": "boolean"
        },
        "is_favorite": {
          "default": false,
          "title": "Is Favorite",
          "type": "boolean"
        },
        "prep_time_minutes": {
          "minimum": 0,
          "title": "Prep Time Minutes",
          "type": "integer"
        },
        "cook_time_minutes": {
          "minimum": 0,
          "title": "Cook Time Minutes",
          "type": "integer"
        },
        "ingredients": {
          "items": {
            "$ref": "#/$defs/RecipeIngredient"
          },
          "title": "Ingredients",
          "type": "array"
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/RecipeStep"
          },
          "title": "Instructions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "servings",
        "total_time_minutes",
        "image_url",
        "prep_time_minutes",
        "cook_time_minutes",
        "ingredients",
        "instructions"
      ],
      "title": "RecipeRead",
      "type": "object"
    },
    "RecipeStep": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "position",
        "text"
      ],
      "title": "RecipeStep",
      "type": "object"
    },
    "ResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_source": {
          "default": "local_json",
          "enum": [
            "local_json",
            "postgresql"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "source_snapshot",
            "demo",
            "user_content",
            "mixed"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "dataset_kind"
      ],
      "title": "ResponseMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "item": {
      "$ref": "#/$defs/RecipeRead"
    },
    "meta": {
      "$ref": "#/$defs/ResponseMeta"
    }
  },
  "required": [
    "item",
    "meta"
  ],
  "title": "Detail[RecipeRead]",
  "type": "object"
}
