{
  "$defs": {
    "RatingCriteria": {
      "additionalProperties": false,
      "properties": {
        "taste": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taste"
        },
        "reliability": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reliability"
        },
        "ease": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ease"
        }
      },
      "title": "RatingCriteria",
      "type": "object"
    },
    "RecipeIngredient": {
      "additionalProperties": false,
      "properties": {
        "ingredient_id": {
          "pattern": "^ing_[a-z0-9_]+$",
          "title": "Ingredient Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "unit",
            "cup",
            "tbsp",
            "tsp"
          ],
          "title": "Unit",
          "type": "string"
        },
        "preparation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preparation"
        }
      },
      "required": [
        "ingredient_id",
        "quantity",
        "unit",
        "preparation"
      ],
      "title": "RecipeIngredient",
      "type": "object"
    },
    "RecipeRatingRead": {
      "additionalProperties": false,
      "properties": {
        "recipe_version": {
          "exclusiveMinimum": 0,
          "title": "Recipe Version",
          "type": "integer"
        },
        "taste_score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Taste Score",
          "type": "integer"
        },
        "reliability_score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Reliability Score",
          "type": "integer"
        },
        "ease_score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Ease Score",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "recipe_version",
        "taste_score",
        "reliability_score",
        "ease_score",
        "created_at",
        "updated_at"
      ],
      "title": "RecipeRatingRead",
      "type": "object"
    },
    "RecipeRatingSummary": {
      "additionalProperties": false,
      "properties": {
        "average": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average"
        },
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "criteria": {
          "$ref": "#/$defs/RatingCriteria"
        }
      },
      "title": "RecipeRatingSummary",
      "type": "object"
    },
    "RecipeRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ingredient_count": {
          "minimum": 0,
          "title": "Ingredient Count",
          "type": "integer"
        },
        "step_count": {
          "minimum": 0,
          "title": "Step Count",
          "type": "integer"
        },
        "content_version": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Content Version",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "servings": {
          "exclusiveMinimum": 0,
          "title": "Servings",
          "type": "integer"
        },
        "total_time_minutes": {
          "minimum": 0,
          "title": "Total Time Minutes",
          "type": "integer"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Url"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "easy",
                "medium",
                "hard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "tags": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Tags",
          "type": "array"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "is_owned": {
          "default": false,
          "title": "Is Owned",
          "type": "boolean"
        },
        "is_favorite": {
          "default": false,
          "title": "Is Favorite",
          "type": "boolean"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "private",
            "public"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "rating": {
          "$ref": "#/$defs/RecipeRatingSummary"
        },
        "prep_time_minutes": {
          "minimum": 0,
          "title": "Prep Time Minutes",
          "type": "integer"
        },
        "cook_time_minutes": {
          "minimum": 0,
          "title": "Cook Time Minutes",
          "type": "integer"
        },
        "ingredients": {
          "items": {
            "$ref": "#/$defs/RecipeIngredient"
          },
          "title": "Ingredients",
          "type": "array"
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/RecipeStep"
          },
          "title": "Instructions",
          "type": "array"
        },
        "my_rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeRatingRead"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "ingredient_count",
        "step_count",
        "name",
        "description",
        "servings",
        "total_time_minutes",
        "image_url",
        "prep_time_minutes",
        "cook_time_minutes",
        "ingredients",
        "instructions"
      ],
      "title": "RecipeRead",
      "type": "object"
    },
    "RecipeStep": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "position",
        "text"
      ],
      "title": "RecipeStep",
      "type": "object"
    },
    "ResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_source": {
          "default": "local_json",
          "enum": [
            "local_json",
            "postgresql"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "source_snapshot",
            "demo",
            "user_content",
            "mixed"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "dataset_kind"
      ],
      "title": "ResponseMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "item": {
      "$ref": "#/$defs/RecipeRead"
    },
    "meta": {
      "$ref": "#/$defs/ResponseMeta"
    }
  },
  "required": [
    "item",
    "meta"
  ],
  "title": "Detail[RecipeRead]",
  "type": "object"
}
