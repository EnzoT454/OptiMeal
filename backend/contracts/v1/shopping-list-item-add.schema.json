{
  "$defs": {
    "ShoppingQuantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "kg",
            "ml",
            "L",
            "unit",
            "cup",
            "tbsp",
            "tsp"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "ShoppingQuantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "ingredient_id": {
      "anyOf": [
        {
          "pattern": "^ing_[a-z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingredient Id"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShoppingQuantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "merge": {
      "default": "add",
      "enum": [
        "add",
        "separate"
      ],
      "title": "Merge",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "name"
  ],
  "title": "ShoppingItemAdd",
  "type": "object"
}
