# Le serveur lit backend/.env au démarrage ; les variables exportées prévalent.
# Ne jamais versionner les vraies clés ni les mots de passe.

# PostgreSQL requis pour les routes Recettes ; optionnel pour les offres JSON.
# Exemple uniquement ; prendre les paramètres réels dans Supabase > Connect.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD_ENCODED@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Ancien emplacement conservé pour compatibilité ; non utilisé par Supabase Auth.
JWT_SECRET=change-me-in-local-development

# Supabase Auth : URL publique du même projet et publishable key (aucune service role).
# Les noms EXPO_PUBLIC_SUPABASE_URL et EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# sont acceptés comme alias si les variables ci-dessous ne sont pas présentes.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXAMPLE

# Collecte Apify : utilisé uniquement par la commande backend.cli.ingest_catalog.
# Exporter la clé dans le terminal ; le CLI ne charge pas automatiquement .env.
APIFY_TOKEN=
# Lecture directe des fiches Maxi ; commandes PCX, sans chargement automatique de .env.
PCX_API_KEY=
# Catalogue validé au démarrage de FastAPI (chemin relatif au dossier de lancement).
# Laisser vide tant qu'aucune collecte n'a été choisie pour exposition HTTP.
CATALOG_IMPORT_PATH=

# API commune /api/v1 : défauts relatifs à la racine du dépôt.
COMMON_CATALOG_PATH=data/catalog/baseCommune/ingredients.json
# Source de la commande d’import ; les routes Recettes lisent la base.
RECIPE_SEED_PATH=data/recipes/initial_recipes.json
