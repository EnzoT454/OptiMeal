# Copier ces valeurs dans un fichier .env local ou les exporter dans le terminal.
# Ne jamais versionner les vraies clés ni les mots de passe.

# Emplacements pour la future persistance et l’authentification (non intégrées).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/optimeal
JWT_SECRET=change-me-in-local-development

# Collecte Apify : utilisé uniquement par la commande backend.cli.ingest_catalog.
# Exporter la clé dans le terminal ; le CLI ne charge pas automatiquement .env.
APIFY_TOKEN=
# Catalogue validé au démarrage de FastAPI (chemin relatif au dossier de lancement).
# Laisser vide tant qu'aucune collecte n'a été choisie pour exposition HTTP.
CATALOG_IMPORT_PATH=
