{
  "info": {
    "name": "OptiMeal — catalogue Maxi",
    "description": "Lectures locales FastAPI, sans collecte Apify. Définir CATALOG_IMPORT_PATH avant le démarrage pour les routes catalogue. Sans fichier, elles retournent 503 ; /health reste disponible.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "ingredient_id",
      "value": "ing_ail_frais"
    }
  ],
  "item": [
    {
      "name": "1 — Serveur",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Serveur disponible\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 — Catalogue configuré",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrat catalogue\", () => pm.expect(pm.response.json().schema_version).to.eql(\"catalog-pilot-1.0\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 — Offres paginées",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/catalog/offers?limit=20&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Offres et total\", () => { const body = pm.response.json(); pm.expect(body.offers).to.be.an(\"array\"); pm.expect(body.total).to.be.a(\"number\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4 — Offres par ingrédient",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/catalog/offers?ingredient_id={{ingredient_id}}&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 — Pagination invalide",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/catalog/offers?limit=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ]
}
