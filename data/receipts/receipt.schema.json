        "arithmetic_status": {
          "enum": [
            "matches",
            "mismatch",
            "unverifiable"
          ],
          "title": "Arithmetic Status",
          "type": "string"
        },
        "tax_check_status": {
          "default": "unverifiable",
          "enum": [
            "matches",
            "mismatch",
            "unverifiable"
          ],
          "title": "Tax Check Status",
          "type": "string"
        }
      },
      "required": [
        "items_sum",
        "arithmetic_status"
      ],
      "title": "ReceiptTotals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "receipt-1.1",
      "default": "receipt-1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "parsing_profile": {
      "default": "generic",
