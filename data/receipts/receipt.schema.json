          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Code"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Raw"
        },
        "format_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Raw"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "unit",
                "kg",
                "lb"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "quantity_source": {
          "default": "unknown",
          "enum": [
            "explicit",
            "unknown"
          ],
          "title": "Quantity Source",
          "type": "string"
        },
        "unit_price": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        },
        "line_total": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Total"
        },
        "source_lines": {
          "items": {
            "type": "string"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "line_id",
        "name",
        "source_lines"
      ],
      "title": "ReceiptItem",
      "type": "object"
    },
    "ReceiptSource": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        }
      },
      "required": [
        "filename",
        "sha256",
        "engine",
        "elapsed_seconds"
      ],
      "title": "ReceiptSource",
      "type": "object"
    },
    "ReceiptTotals": {
      "additionalProperties": false,
