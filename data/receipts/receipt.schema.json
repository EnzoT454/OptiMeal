{
  "$defs": {
    "ReceiptAdjustment": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "effect": {
          "enum": [
            "applied",
            "informational",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "source_line": {
          "title": "Source Line",
          "type": "string"
        },
        "review_required": {
          "const": true,
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "effect",
        "source_line"
      ],
      "title": "ReceiptAdjustment",
      "type": "object"
    },
    "ReceiptItem": {
      "additionalProperties": false,
