      "type": "string"
    },
    "status": {
      "const": "review_required",
      "default": "review_required",
      "title": "Status",
      "type": "string"
    },
    "source_kind": {
      "const": "receipt",
      "default": "receipt",
      "title": "Source Kind",
      "type": "string"
    },
    "currency": {
      "const": "CAD",
