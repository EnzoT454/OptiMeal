{
  "expo": {
    "name": "OptiMeal",
    "slug": "optimeal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.optimeal"
    },
    "android": {
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "scheme": "optimeal",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "OptiMeal utilise la photo choisie pour illustrer ta recette.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image"
    ]
  }
}
